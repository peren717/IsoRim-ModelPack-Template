# Materials for the IsoRim binder samples. Kd = colour, map_Kd = a texture under any mod's Textures folder (no extension).
# Names starting with "stuff" take the colour of what the thing is made of; "glow"/"flame" are unlit.
newmtl stuff_dark
Kd 0.800 0.800 0.800
map_Kd IsoRim/Swatches/{stuff}

newmtl mypack_metal
Kd 0.600 0.620 0.650
map_Kd IsoRim/Swatches/Metal

newmtl mypack_metal_dark
Kd 0.360 0.380 0.410
map_Kd IsoRim/Swatches/Metal

newmtl mypack_marker
Kd 0.780 0.220 0.180
