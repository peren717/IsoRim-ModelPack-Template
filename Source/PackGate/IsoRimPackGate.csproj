<Project Sdk="Microsoft.NET.Sdk">
  <!-- IsoRimPackGate.dll, the patch class of the pack (PatchOperation_IfIsoRimApi). The built DLL is already in 1.7/Assemblies;
       you only need this to rebuild it. Keep it identical to IsoRim's Tools/PackGate (every pack ships the same file).
       dotnet build Source/PackGate/IsoRimPackGate.csproj -c Release "-p:RimWorldDir=C:\path\to\RimWorld" -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>IsoRimPackGate</AssemblyName>
    <RootNamespace>IsoRimPackGate</RootNamespace>
    <Version>1.0.0</Version>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Optimize>true</Optimize>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(RimWorldDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
